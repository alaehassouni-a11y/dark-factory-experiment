# Virtual Agent backend, local development. Copy to app/.env (gitignored) and fill in.
# Real secrets never live in the repo; on the production host they live in /opt/virtualagent/.env.

# OpenRouter: chat completions (answers) and embeddings (wiki index). Required.
OPENROUTER_API_KEY=

# Brave Search: the web fallback. Optional; when unset the agent says it does not know
# whenever the wiki has no answer, and /api/health reports web_search=unconfigured.
BRAVE_SEARCH_API_KEY=

# Where the wiki lives. Default: <repo>/virtualagent/resources
# WIKI_RESOURCES_DIR=

# Comma-separated CORS origins, only needed for a browser-based test console.
# CORS_ORIGINS=
