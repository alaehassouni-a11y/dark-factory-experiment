# Virtual Agent production secrets. Copy to /opt/virtualagent/.env and fill in values.
# .env is gitignored - NEVER commit the filled-in version. docker-compose.yml reads it
# with --env-file; nothing else on the host does.

# The public hostname Caddy serves and the Let's Encrypt contact. Both required: compose
# refuses to start Caddy without them. Changing either later means `docker compose
# --env-file /opt/virtualagent/.env up -d caddy` (recreate), not a reload.
VIRTUALAGENT_HOST=
LETSENCRYPT_EMAIL=

# OpenRouter: chat completions (the answers) and embeddings (the wiki index). Required.
# The service refuses to start without it, and the healthcheck only passes once the
# wiki has been indexed through it.
OPENROUTER_API_KEY=

# Brave Search: the web fallback. Optional. When unset the agent answers from the wiki
# only and says it does not know otherwise; /api/health reports web_search=unconfigured.
BRAVE_SEARCH_API_KEY=

# OpenRouter chat model. Optional; defaults to anthropic/claude-sonnet-4.6. Set it only
# to canary a model on the inactive colour before flipping Caddy.
# CHAT_MODEL=

# Comma-separated browser origins allowed to call the API. Optional. The iOS app needs
# none; leave empty unless a browser-based test console is in use.
# CORS_ORIGINS=

# THE LIVE WIKI: a folder on this host that the service watches. Drop a document in it
# (or write one with tools/wiki/ingest.py) and the agent knows it within seconds; nothing
# is built or flipped. Default when unset: the checkout's own virtualagent/resources.
# WIKI_DIR=/opt/virtualagent/wiki

# WIKI_RESOURCES_DIR is deliberately NOT here. docker-compose.yml pins it to
# /app/virtualagent/resources inside the container and mounts WIKI_DIR there.
